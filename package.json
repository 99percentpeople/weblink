{
  "name": "weblink-workspace",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "servers/*"
  ],
  "overrides": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun --env-file=.env run --parallel dev:web dev:server",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "dev:server": "bun run --cwd servers/weblink-ws-server dev",
    "build": "bun run --cwd apps/web build",
    "build:dev": "bun run --cwd apps/web build:dev",
    "dev:worker": "bun run --watch --cwd servers/weblink-ws-worker dev",
    "preview": "bun run --cwd apps/web preview",
    "test": "bun run --cwd apps/web test",
    "generate-pwa-assets": "bun run --cwd apps/web generate-pwa-assets",
    "lint": "bun run --cwd apps/web lint",
    "appwrite:setup": "bun run --cwd apps/web appwrite:setup",
    "test:unit": "bun run --cwd apps/web test:unit",
    "test:integration": "bun run --cwd apps/web test:integration",
    "test:e2e:protocol": "bun run --cwd apps/web test:e2e:protocol",
    "test:e2e:recovery": "bun run --cwd apps/web test:e2e:recovery",
    "test:e2e:native-screen": "bun run --cwd apps/web test:e2e:native-screen",
    "test:e2e:playback": "bun run --cwd apps/web test:e2e:playback",
    "test:e2e:transfer": "bun run --cwd apps/web test:e2e:transfer",
    "test:e2e:cache": "bun run --cwd apps/web test:e2e:cache",
    "test:e2e:tasks": "bun run --cwd apps/web test:e2e:tasks",
    "test:e2e:chat": "bun run --cwd apps/web test:e2e:chat",
    "test:e2e:conversations": "bun run --cwd apps/web test:e2e:conversations",
    "test:e2e:meeting": "bun run --cwd apps/web test:e2e:meeting",
    "test:e2e:speed": "bun run --cwd apps/web test:e2e:speed",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "bench:browser:cache": "bun run --cwd apps/web bench:browser:cache",
    "prepare": "husky",
    "clean": "node scripts/clean.mjs",
    "submodules:init": "git submodule update --init --recursive",
    "test:server": "bun run --cwd servers/weblink-ws-server test",
    "test:worker": "bun run --cwd servers/weblink-ws-worker test",
    "build:server": "bun run --cwd servers/weblink-ws-server build",
    "build:desktop": "bun run --cwd apps/desktop build",
    "check:desktop": "bun run --cwd apps/desktop lint && bun run --cwd apps/desktop check",
    "sync": "bun --env-file=.env scripts/sync.mjs",
    "sync:watch": "bun --env-file=.env scripts/sync.mjs --watch"
  },
  "lint-staged": {
    "**/*.{js,jsx,mjs,ts,tsx,css,html,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "prettier-plugin-classnames": "^0.7.9",
    "prettier-plugin-merge": "^0.7.4",
    "prettier-plugin-tailwindcss": "^0.6.14"
  }
}
