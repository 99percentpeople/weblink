# Local development: copy to .env and run bun dev.
WEBLINK_WEB_PORT=5173
PORT=9000
HOSTNAME=127.0.0.1
WEBLINK_WEBSOCKET_URL=ws://127.0.0.1:${PORT}

# One-way source sync over SSH (Linux, macOS or Windows with rsync).
# WEBLINK_SYNC_TARGET=user@host:/path/to/weblink
# Optional remote rsync executable; defaults to rsync on PATH.
# WEBLINK_SYNC_RSYNC=/usr/local/bin/rsync
