# Signaling backend used by the browser.
VITE_WEBSOCKET_URL=wss://ws.webl.ink

# Optional public URL for room links and QR codes. Browsers default to their
# current origin. Desktop defaults to dev.webl.ink locally and webl.ink in builds;
# Preview CI sets https://dev.webl.ink. Override for a self-hosted frontend.
# VITE_SHARE_URL=https://webl.ink

# Comma-separated STUN endpoints.
WEBLINK_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional additional TURN relays only. Cloudflare-managed TURN credentials
# are obtained automatically from the signaling backend.
# VITE_TURN_SERVERS=turn:turn.example.com:3478|user|password|longterm
