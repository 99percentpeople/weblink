# Signaling backend used by the browser.
VITE_WEBSOCKET_URL=wss://ws.webl.ink

# Comma-separated STUN endpoints.
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional additional TURN relays only. Cloudflare-managed TURN credentials
# are obtained automatically from the signaling backend.
# VITE_TURN_SERVERS=turn:turn.example.com:3478|user|password|longterm
