{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main application can query capabilities, control native screen sharing and open web links.",
  "windows": ["main"],
  "permissions": [
    "allow-runtime-capabilities",
    "allow-automation-open",
    "allow-automation-heartbeat",
    "allow-automation-close",
    "allow-automation-configure",
    "allow-automation-mcp-configure",
    "allow-automation-server-configure",
    "allow-automation-snapshot",
    "allow-automation-client",
    "allow-automation-client-update",
    "allow-automation-client-remove",
    "allow-automation-disconnect",
    "allow-automation-peer",
    "allow-automation-peer-policy",
    "allow-automation-decide",
    "allow-automation-revoke",
    "allow-automation-call",
    "allow-automation-cancel",
    "allow-automation-check",
    "allow-automation-finish",
    "allow-automation-action",

    "allow-vfs-volumes",
    "allow-vfs-pick-directory",
    "allow-vfs-open-directory",
    "allow-vfs-open-file",
    "allow-vfs-reveal-file",
    "allow-vfs-stat",
    "allow-vfs-list",
    "allow-vfs-read",
    "allow-vfs-resize",
    "allow-vfs-write",
    "allow-vfs-sync",
    "allow-vfs-remove",
    "allow-vfs-move",
    "allow-vfs-watch",
    "allow-vfs-unwatch",
    "allow-vfs-media",
    "allow-vfs-writer-open",
    "allow-vfs-writer-append",
    "allow-vfs-writer-close",
    "allow-vfs-writer-abort",

    "allow-file-save-begin",
    "allow-file-save-directory-pick",
    "allow-file-save-directory-begin",
    "allow-file-save-directory-release",
    "allow-file-open-begin",
    "allow-file-save-write",
    "allow-file-save-finish",
    "allow-file-save-abort",
    "allow-updates-check",
    "allow-updates-install",
    "allow-application-device-name",
    "allow-application-configure",
    "allow-application-visibility-watch",
    "allow-application-visibility-unwatch",
    "core:window:allow-close",
    "allow-application-autostart-status",
    "allow-application-autostart-set",
    "allow-application-startup-behavior",
    "allow-application-startup-set-behavior",
    "allow-pip-watch",
    "allow-pip-unwatch",
    "allow-pip-configure",
    "allow-pip-enter",
    "allow-pip-exit",
    "allow-pip-drag",
    "allow-application-close-watch",
    "allow-application-close-unwatch",
    "allow-application-close-respond",
    "allow-keyboard-start",
    "allow-keyboard-renew",
    "allow-keyboard-stop",
    "allow-remote-control-open",
    "allow-remote-control-devices",
    "allow-remote-control-configure-shortcut",
    "allow-clipboard-sequence",
    "allow-clipboard-watch",
    "allow-clipboard-unwatch",
    "allow-clipboard-read",
    "allow-clipboard-write",
    "allow-file-drop-hover",
    "allow-file-drop-prepare",
    "allow-file-drop-apply",
    "allow-file-drop-cancel",
    "allow-remote-control-status",
    "allow-remote-control-watch",
    "allow-remote-control-unwatch",
    "allow-remote-control-end",
    "allow-remote-control-revoke",
    "allow-remote-control-approve",
    "allow-capture-sources",
    "allow-capture-display-layout",
    "allow-capture-thumbnail",
    "allow-capture-codecs",
    "allow-capture-audio-formats",
    "allow-capture-backends",
    "allow-capture-encoders",
    "allow-capture-start",
    "allow-capture-status",
    "allow-capture-renew",
    "allow-capture-watch",
    "allow-capture-unwatch",
    "allow-capture-stop",
    "allow-capture-share-start",
    "allow-capture-set-audio-enabled",
    "allow-capture-update-video-settings",
    "allow-capture-video-stats",
    "allow-capture-pipeline-stats",
    "allow-capture-preview-open",
    "allow-capture-preview-frame",
    "allow-capture-preview-visible",
    "allow-capture-preview-close",
    "allow-capture-offer",
    "allow-capture-recording-offer",
    "allow-capture-recording-open",
    "allow-capture-recording-read",
    "allow-capture-recording-control",
    "allow-capture-recording-close",
    "allow-capture-answer",
    "allow-capture-add-ice-candidate",
    "allow-capture-close-peer",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "allow-notifications-capabilities",
    "allow-notifications-request-permission",
    "allow-notifications-watch",
    "allow-notifications-unwatch",
    "allow-notifications-show",
    "allow-notifications-dismiss",
    "allow-application-show"
  ]
}
