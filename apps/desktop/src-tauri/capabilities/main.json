{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main application can query capabilities, control native screen sharing and open web links.",
  "windows": ["main"],
  "permissions": [
    "allow-runtime-capabilities",
    "allow-capture-sources",
    "allow-capture-display-layout",
    "allow-capture-thumbnail",
    "allow-capture-codecs",
    "allow-capture-backends",
    "allow-capture-encoders",
    "allow-capture-start",
    "allow-capture-status",
    "allow-capture-stop",
    "allow-capture-share-start",
    "allow-capture-set-audio-enabled",
    "allow-capture-update-video-settings",
    "allow-capture-video-stats",
    "allow-capture-pipeline-stats",
    "allow-capture-preview-open",
    "allow-capture-preview-frame",
    "allow-capture-preview-close",
    "allow-capture-offer",
    "allow-capture-answer",
    "allow-capture-add-ice-candidate",
    "allow-capture-close-peer",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
