{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main application can query capabilities, control native screen sharing and open web links.",
  "windows": ["main"],
  "permissions": [
    "allow-runtime-capabilities",
    "allow-application-configure",
    "core:window:allow-close",
    "allow-application-autostart-enabled",
    "allow-application-autostart-set",
    "allow-application-startup-behavior",
    "allow-application-startup-set-behavior",
    "allow-pip-watch",
    "allow-pip-unwatch",
    "allow-pip-configure",
    "allow-pip-enter",
    "allow-pip-exit",
    "allow-pip-drag",
    "allow-application-close-watch",
    "allow-application-close-unwatch",
    "allow-application-close-respond",
    "allow-keyboard-start",
    "allow-keyboard-renew",
    "allow-keyboard-stop",
    "allow-remote-control-open",
    "allow-remote-control-status",
    "allow-remote-control-end",
    "allow-remote-control-revoke",
    "allow-remote-control-approve",
    "allow-capture-sources",
    "allow-capture-display-layout",
    "allow-capture-thumbnail",
    "allow-capture-codecs",
    "allow-capture-audio-formats",
    "allow-capture-backends",
    "allow-capture-encoders",
    "allow-capture-start",
    "allow-capture-status",
    "allow-capture-stop",
    "allow-capture-share-start",
    "allow-capture-set-audio-enabled",
    "allow-capture-update-video-settings",
    "allow-capture-video-stats",
    "allow-capture-pipeline-stats",
    "allow-capture-preview-open",
    "allow-capture-preview-frame",
    "allow-capture-preview-close",
    "allow-capture-offer",
    "allow-capture-answer",
    "allow-capture-add-ice-candidate",
    "allow-capture-close-peer",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "allow-notifications-capabilities",
    "allow-notifications-request-permission",
    "allow-notifications-watch",
    "allow-notifications-unwatch",
    "allow-notifications-show",
    "allow-notifications-dismiss",
    "allow-application-show"
  ]
}
